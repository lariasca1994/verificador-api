# Copia este archivo como .env y completa los valores.
# El .env está en .gitignore y no debe subirse nunca al repositorio.

# --- Conexión a PostgreSQL (Neon) -----------------------------------------
# La consigues en tu panel de Neon: Dashboard > tu proyecto > Connection
# Details > Connection string. Usa la variante "Pooled connection" (el
# host trae "-pooler" en el nombre) — Neon la recomienda para apps web,
# porque reutiliza conexiones en vez de abrir una nueva por cada request.
#
# Neon exige TLS: la cadena YA debe incluir "?sslmode=require" al final,
# tal como el panel te la entrega. No la quites.
DATABASE_URL=postgresql://usuario:password@ep-xxxxx-pooler.us-east-2.aws.neon.tech/verificador_api?sslmode=require

# --- Sesión ----------------------------------------------------------------
# Cadena larga y aleatoria para firmar el JWT de sesión (cookie httponly).
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# URL del propio sitio (para CORS si algún día se separa el frontend).
CLIENT_URL=http://localhost:8300
